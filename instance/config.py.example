# Copy this file to config.py and fill in your actual values
# DO NOT commit the config.py file - it's in .gitignore

# Flask secret key for session management and CSRF protection
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY='your_secret_key_here'

# SQLAlchemy Database URI
# Format: mysql+mysqlconnector://username:password@host:port/database_name
SQLALCHEMY_DATABASE_URI='mysql+mysqlconnector://root:your_password@localhost/mycircledb'
