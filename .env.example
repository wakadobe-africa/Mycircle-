# ─────────────────────────────────────────────────────────────────────────────
# MyCIRCLE environment variable template
# Copy this file to .env and fill in your actual values.
# .env is listed in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-generate-a-strong-key

# Full SQLAlchemy database URI
# Format: mysql+mysqlconnector://user:password@host:port/dbname
DATABASE_URI=mysql+mysqlconnector://root:your_password@localhost/mycircledb

# Individual DB pieces (used by docker-compose and helper scripts)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=mycircledb

# Set to "true" only during local development; NEVER in production
FLASK_DEBUG=false

# Port the app listens on (default 5000 for dev, often 8000 or 80 in production)
PORT=5000
